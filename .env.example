# ==============================================================================
# Jarvis-X Environment Configuration Template
# Copy this file to .env and configure your local settings.
# NEVER commit the actual .env file containing real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Agent & Model Settings
# ------------------------------------------------------------------------------
JARVIS_MODEL=llama3.2:3b
JARVIS_MODEL_PLANNER=llama3.2:3b
JARVIS_MODEL_CODER=llama3.2:3b
JARVIS_MODEL_REVIEWER=llama3.2:3b
JARVIS_MODEL_FAST=llama3.2:1b

# ------------------------------------------------------------------------------
# Execution & Reliability Bounds
# ------------------------------------------------------------------------------
JARVIS_MAX_RETRY=3
JARVIS_TIMEOUT=30
JARVIS_WORKSPACE=workspace
JARVIS_QUALITY_GATE=95.0
JARVIS_MAX_REFINEMENT=5

# ------------------------------------------------------------------------------
# Knowledge & Memory Paths
# ------------------------------------------------------------------------------
JARVIS_KNOWLEDGE_PATH=data/knowledge.json
JARVIS_EXPERIENCES_PATH=data/experiences.json
JARVIS_LESSONS_PATH=data/lessons.json
JARVIS_SEMANTIC_MEMORY_PATH=data/semantic_memory.json

# ------------------------------------------------------------------------------
# External API Credentials (Optional - leave blank if running purely local Ollama)
# ------------------------------------------------------------------------------
API_KEY=
DEEPGRAM_API_KEY=

